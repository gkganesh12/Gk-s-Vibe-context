{
  "name": "vibe-context",
  "displayName": "Vibe Context",
  "description": "Captures session-level developer intent during coding",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibeContext.startSession",
        "title": "Context: Start Session",
        "category": "Vibe Context"
      },
      {
        "command": "vibeContext.endSession",
        "title": "Context: End Session",
        "category": "Vibe Context"
      },
      {
        "command": "vibeContext.explainFromMemory",
        "title": "Context: Explain From Memory",
        "category": "Vibe Context"
      },
      {
        "command": "vibeContext.getContextForAI",
        "title": "Context: Get Context for AI",
        "category": "Vibe Context"
      }
    ],
    "keybindings": [
      {
        "command": "vibeContext.startSession",
        "key": "cmd+shift+v",
        "mac": "cmd+shift+v"
      },
      {
        "command": "vibeContext.endSession",
        "key": "cmd+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "vibeContext.explainFromMemory",
        "key": "cmd+shift+x",
        "mac": "cmd+shift+x"
      },
      {
        "command": "vibeContext.getContextForAI",
        "key": "cmd+shift+c",
        "mac": "cmd+shift+c"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}

